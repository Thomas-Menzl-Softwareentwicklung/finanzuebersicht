default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)

# Must match device names in Snapfile.
SNAPFILE_DEVICES = [
  "iPhone 17",
  "iPad Pro 13-inch (M5)"
].freeze

# On-disk simulator bundle name from `dotnet build` (ASCII folder; ApplicationTitle may differ).
MAUI_APP_NAME = "Finanzuebersicht.app"

MAUI_BUILD_CMD = [
  "dotnet build Finanzuebersicht/Finanzuebersicht.csproj",
  "-f net10.0-ios",
  "-c Debug",
  "-p:RuntimeIdentifier=iossimulator-arm64"
].join(" ")

def maui_sim_app_path
  File.join(
    REPO_ROOT,
    "Finanzuebersicht/bin/Debug/net10.0-ios/iossimulator-arm64/#{MAUI_APP_NAME}"
  )
end

def install_maui_app_on_snapfile_simulators
  app_path = maui_sim_app_path
  unless File.directory?(app_path)
    UI.user_error!(
      "MAUI simulator app not found at:\n  #{app_path}\n\n" \
      "Build and retry (from repo root):\n  #{MAUI_BUILD_CMD}"
    )
  end

  SNAPFILE_DEVICES.each do |device|
    UI.message("Installing #{MAUI_APP_NAME} on #{device}…")
    sh("xcrun simctl boot \"#{device}\" 2>/dev/null || true")
    sh("xcrun simctl install \"#{device}\" \"#{app_path}\"")
  end
end

platform :ios do
  desc "Capture App Store screenshots (2 devices × 2 locales)"
  lane :screenshots do
    uitests_dir = File.join(REPO_ROOT, "Finanzuebersicht/Platforms/iOS/UITests")
    xcodeproj = File.join(uitests_dir, "FinanzuebersichtUITests.xcodeproj")

    unless File.directory?(xcodeproj)
      UI.message("Generating Xcode project via XcodeGen…")
      sh("cd \"#{uitests_dir}\" && xcodegen generate")
    end

    install_maui_app_on_snapfile_simulators

    # Pass absolute project path — Snapfile relative paths are unreliable when
    # fastlane's CWD is the fastlane/ directory.
    capture_screenshots(
      skip_open_summary: true,
      project: File.join(
        REPO_ROOT,
        "Finanzuebersicht/Platforms/iOS/UITests/FinanzuebersichtUITests.xcodeproj"
      ),
      output_directory: File.join(REPO_ROOT, "fastlane/screenshots")
    )
  end
end
