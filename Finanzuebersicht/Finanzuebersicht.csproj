<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Finanzuebersicht</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Finanzübersicht</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>de.thomasmenzl.finanzuebersicht</ApplicationId>

		<!-- Direct = GitHub/self-built (default). Store = App Store / Mac App Store (-p:AppDistribution=Store). -->
		<AppDistribution Condition="'$(AppDistribution)' == ''">Direct</AppDistribution>
		<DefineConstants Condition="'$(AppDistribution)' == 'Store'">$(DefineConstants);APP_DISTRIBUTION_STORE</DefineConstants>

		<!-- Nerdbank.GitVersioning: eigene MAUI-Versionierung unten (MajorMinor für Anzeige) -->
		<NBGV_SetMauiVersionProperties>false</NBGV_SetMauiVersionProperties>

		<!-- Versions (overridden at build time by Nerdbank.GitVersioning target below) -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<EnableWindowsTargeting Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</EnableWindowsTargeting>
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<!-- Xcode 26.3 installiert, SDK erwartet 26.2 – Prüfung deaktiviert bis SDK-Update -->
		<ValidateXcodeVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">false</ValidateXcodeVersion>

		<!-- Debug: Sandbox-freie Entitlements damit Ad-hoc-Sign ohne TeamID startet -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>

		<!-- Debug: Ad-hoc-Signatur (Launch Constraint auf macOS 26+ blockiert Apple Development aus Applications) -->
		<CodesignKey Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">-</CodesignKey>

		<!-- iOS: Entitlements und Signing -->
		<!-- Debug: get-task-allow; Release: distribution-safe (kein get-task-allow) -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms/iOS/Entitlements.Debug.plist</CodesignEntitlements>
		<CodesignEntitlements Condition="'$(Configuration)' != 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms/iOS/Entitlements.plist</CodesignEntitlements>
		<DevelopmentTeam Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">XY663DU933</DevelopmentTeam>
		<CodesignKey Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Apple Development</CodesignKey>
		<CodesignProvision Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Automatic</CodesignProvision>
		<!-- Release: TeamID + Distribution Profile lokal oder per CI setzen (siehe docs/APP_STORE.md) -->
		<!-- <CodesignKey Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Apple Distribution</CodesignKey> -->
		<!-- <CodesignProvision Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Finanzuebersicht App Store</CodesignProvision> -->

		<!-- Suppress MT4162 warning from mtouch (but not via ILLink) -->
		<!-- Note: passing -nowarn:MT4162 directly to MtouchExtraArgs might be picked up by ILLink and fail -->
		<!-- We rely on MtouchLink=None to disable ILLink instead -->

		<!-- Disable ILLink completely to avoid MT2301/NETSDK1144 crash -->
		<MtouchLink>SdkOnly</MtouchLink>
		<UserDialogs>false</UserDialogs>
		<!-- Ensure UseInterpreter is true if link is None, though usually implied for Debug -->
		<UseInterpreter Condition="'$(Configuration)' == 'Debug'">true</UseInterpreter>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#007AFF" />

		<!-- Splash: plain app background (PageBackground), no .NET branding -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F2F2F7" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Categorization Rules Data -->
		<MauiAsset Include="..\Finanzuebersicht.Core\Data\categorization-rules.json" LogicalName="Data/categorization-rules.json" />

		<!-- Localization Resources (SDK includes .resx automatically; set DependentUpon for IDE) -->
		<EmbeddedResource Update="Resources\Strings\AppResources.de.resx">
			<DependentUpon>AppResources.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Finanzuebersicht.Application\Finanzuebersicht.Application.csproj" />
		<ProjectReference Include="..\Finanzuebersicht.Core\Finanzuebersicht.Core.csproj" />
		<ProjectReference Include="..\Finanzuebersicht.Infrastructure\Finanzuebersicht.Infrastructure.csproj" />
		<ProjectReference Include="..\Finanzuebersicht.Presentation\Finanzuebersicht.Presentation.csproj" />
	</ItemGroup>

	<!-- WidgetKit sources are built with Xcode on Mac — not by the .NET compiler. -->
	<ItemGroup>
		<None Include="Platforms\iOS\Widgets\**\*" />
		<Content Remove="Platforms\iOS\Widgets\**\*" Condition="Exists('Platforms\iOS\Widgets')" />
		<Compile Remove="Platforms\iOS\Widgets\**\*" />
		<_MauiCompileToXaml Remove="Platforms\iOS\Widgets\**\*" />
		<!-- Custom Shell renderer incompatible with UIScene (iOS 27 / Mac Catalyst). -->
		<Compile Remove="Handlers\FastShellRenderer.cs" />
		<None Include="Handlers\FastShellRenderer.cs" />
	</ItemGroup>

	<!-- Embed QuickExpenseWidget.appex (built by BuildWidgetExtension / build-release.sh).
	     Pattern: Redth Maui.Apple.PlatformFeature.Samples — Widgets.
	     Skip rebuild: -p:SkipWidgetBuild=true (keeps previously staged .appex).
	     Skip embed entirely: -p:EmbedQuickExpenseWidget=false -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<EmbedQuickExpenseWidget Condition="'$(EmbedQuickExpenseWidget)' == ''">true</EmbedQuickExpenseWidget>
	</PropertyGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) AND '$(EmbedQuickExpenseWidget)' == 'true'">
		<!-- Staging lives at $(MSBuildProjectDirectory)/WidgetExtensions (NOT under Platforms/,
		     or SingleProject packs an unsigned .appex into the .app and ASC rejects it). -->
		<Content Remove="WidgetExtensions\**" />
		<None Remove="WidgetExtensions\**" />
		<MauiAsset Remove="WidgetExtensions\**" />
		<_MauiCompileToXaml Remove="WidgetExtensions\**" />
		<!-- Legacy path — exclude if a leftover folder exists -->
		<Content Remove="Platforms\iOS\WidgetExtensions\**" />
		<None Remove="Platforms\iOS\WidgetExtensions\**" />
		<MauiAsset Remove="Platforms\iOS\WidgetExtensions\**" />

		<AdditionalAppExtensions Include="$(MSBuildProjectDirectory)/WidgetExtensions">
			<Name>QuickExpenseWidget</Name>
			<BuildOutput Condition="'$(ComputedPlatform)' == 'iPhone'">Release-iphoneos</BuildOutput>
			<BuildOutput Condition="'$(ComputedPlatform)' == 'iPhoneSimulator'">Release-iphonesimulator</BuildOutput>
			<!-- Must live next to staging folder / match Name (dotnet/macios #8933). -->
			<CodesignEntitlements>$(MSBuildProjectDirectory)/WidgetExtensions/QuickExpenseWidget.entitlements</CodesignEntitlements>
		</AdditionalAppExtensions>
	</ItemGroup>

	<!-- Swift @_cdecl bridge: WidgetCenter.reload* (Swift-only API). Built by BuildWidgetKitBridge. -->
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) AND '$(EmbedQuickExpenseWidget)' == 'true'">
		<NativeReference Include="Platforms/iOS/Native/lib/Release-iphoneos/libWidgetKitBridge.a"
		                 Condition="!$(RuntimeIdentifier.Contains('simulator'))">
			<Kind>Static</Kind>
			<ForceLoad>true</ForceLoad>
			<Frameworks>WidgetKit</Frameworks>
		</NativeReference>
		<NativeReference Include="Platforms/iOS/Native/lib/Release-iphonesimulator/libWidgetKitBridge.a"
		                 Condition="$(RuntimeIdentifier.Contains('simulator'))">
			<Kind>Static</Kind>
			<ForceLoad>true</ForceLoad>
			<Frameworks>WidgetKit</Frameworks>
		</NativeReference>
	</ItemGroup>

	<!-- Store: re-sign PlugIns/*.appex with Distribution + Store profile, then re-seal outer .app
	     with the FULL Release entitlements (incl. application-identifier — do not strip). -->
	<Target Name="ResignWidgetExtensionForStore"
	        AfterTargets="_CodesignAppBundle"
	        DependsOnTargets="GetBuildVersion"
	        Condition="$(TargetFramework.Contains('-ios')) AND '$(EmbedQuickExpenseWidget)' == 'true' AND '$(AppDistribution)' == 'Store' AND '$(ComputedPlatform)' == 'iPhone'">
		<PropertyGroup>
			<_WidgetAppexInBundle Condition="'$(AppBundleDir)' != ''">$(AppBundleDir)/PlugIns/QuickExpenseWidget.appex</_WidgetAppexInBundle>
			<_WidgetAppexInBundle Condition="'$(_WidgetAppexInBundle)' == ''">$(OutputPath)$(RuntimeIdentifier)/$(ApplicationTitle).app/PlugIns/QuickExpenseWidget.appex</_WidgetAppexInBundle>
			<_StoreAppEntitlements>$(MSBuildProjectDirectory)/Platforms/iOS/Entitlements.plist</_StoreAppEntitlements>
			<_WidgetMarketingVersion Condition="'$(ApplicationDisplayVersion)' != ''">$(ApplicationDisplayVersion)</_WidgetMarketingVersion>
			<_WidgetMarketingVersion Condition="'$(_WidgetMarketingVersion)' == ''">$(MajorMinorVersion)</_WidgetMarketingVersion>
			<_WidgetBuildVersion Condition="'$(ApplicationVersion)' != ''">$(ApplicationVersion)</_WidgetBuildVersion>
			<_WidgetBuildVersion Condition="'$(_WidgetBuildVersion)' == ''">$(BuildVersionSimple)</_WidgetBuildVersion>
		</PropertyGroup>
		<Error Text="Widget appex missing in app bundle: $(_WidgetAppexInBundle)"
		       Condition="!Exists('$(_WidgetAppexInBundle)')" />
		<Error Text="Store entitlements missing: $(_StoreAppEntitlements)"
		       Condition="!Exists('$(_StoreAppEntitlements)')" />
		<Exec Command="MARKETING_VERSION=&quot;$(_WidgetMarketingVersion)&quot; CURRENT_PROJECT_VERSION=&quot;$(_WidgetBuildVersion)&quot; bash Platforms/iOS/sign-widget-store.sh &quot;$(_WidgetAppexInBundle)&quot;"
		      WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="codesign --force --sign &quot;$(CodesignKey)&quot; --entitlements &quot;$(_StoreAppEntitlements)&quot; --timestamp=none &quot;$(AppBundleDir)&quot;"
		      Condition="'$(AppBundleDir)' != '' AND '$(CodesignKey)' != ''" />
	</Target>

	<!-- Builds Swift WidgetKitBridge.a for P/Invoke reloadAllTimelines (Swift-only WidgetCenter). -->
	<Target Name="BuildWidgetKitBridge"
	        BeforeTargets="ResolveNativeReferences;_AOTCompile;CoreCompile"
	        Condition="$(TargetFramework.Contains('-ios')) AND '$(EmbedQuickExpenseWidget)' == 'true' AND '$(SkipWidgetKitBridgeBuild)' != 'true'">
		<PropertyGroup>
			<_BridgeIsSimulator>$(RuntimeIdentifier.Contains('simulator'))</_BridgeIsSimulator>
			<_BridgeSubdir Condition="'$(_BridgeIsSimulator)' == 'true'">Release-iphonesimulator</_BridgeSubdir>
			<_BridgeSubdir Condition="'$(_BridgeIsSimulator)' != 'true'">Release-iphoneos</_BridgeSubdir>
			<_BridgeLib>$(MSBuildProjectDirectory)/Platforms/iOS/Native/lib/$(_BridgeSubdir)/libWidgetKitBridge.a</_BridgeLib>
		</PropertyGroup>
		<Message Text="Building WidgetKitBridge.a via Platforms/iOS/Native/build-widgetkit-bridge.sh..." Importance="high" />
		<Exec Command="bash build-widgetkit-bridge.sh"
		      WorkingDirectory="$(MSBuildProjectDirectory)/Platforms/iOS/Native" />
		<Error Text="Expected WidgetKit bridge at $(_BridgeLib)."
		       Condition="!Exists('$(_BridgeLib)')" />
	</Target>

	<!-- Builds Platforms/iOS/Widgets via build-release.sh (xcodegen + xcodebuild), stages .appex. -->
	<Target Name="BuildWidgetExtension"
	        AfterTargets="ResolveReferences"
	        DependsOnTargets="GetBuildVersion"
	        Condition="$(TargetFramework.Contains('-ios')) AND '$(EmbedQuickExpenseWidget)' == 'true' AND '$(SkipWidgetBuild)' != 'true'">

		<PropertyGroup>
			<_XcodeProjectDir>$(MSBuildProjectDirectory)/Platforms/iOS/Widgets</_XcodeProjectDir>
			<_WidgetIsSimulator>$(RuntimeIdentifier.Contains('simulator'))</_WidgetIsSimulator>
			<_WidgetOutputSubdir Condition="'$(_WidgetIsSimulator)' == 'true'">Release-iphonesimulator</_WidgetOutputSubdir>
			<_WidgetOutputSubdir Condition="'$(_WidgetIsSimulator)' != 'true'">Release-iphoneos</_WidgetOutputSubdir>
			<_WidgetDestAppex>$(MSBuildProjectDirectory)/WidgetExtensions/$(_WidgetOutputSubdir)/QuickExpenseWidget.appex</_WidgetDestAppex>
			<_WidgetMarketingVersion Condition="'$(MajorMinorVersion)' != ''">$(MajorMinorVersion)</_WidgetMarketingVersion>
			<_WidgetMarketingVersion Condition="'$(_WidgetMarketingVersion)' == ''">1.19</_WidgetMarketingVersion>
			<_WidgetBuildVersion Condition="'$(BuildVersionSimple)' != ''">$(BuildVersionSimple)</_WidgetBuildVersion>
			<_WidgetBuildVersion Condition="'$(_WidgetBuildVersion)' == ''">$(_WidgetMarketingVersion)</_WidgetBuildVersion>
		</PropertyGroup>

		<Error Text="Widget sources not found at $(_XcodeProjectDir). See Platforms/iOS/Widgets/README.md."
		       Condition="!Exists('$(_XcodeProjectDir)/project.yml')" />

		<Message Text="Building QuickExpenseWidget.appex via Platforms/iOS/Widgets/build-release.sh (v$(_WidgetMarketingVersion) / $(_WidgetBuildVersion))..." Importance="high" />
		<Exec Command="MARKETING_VERSION=&quot;$(_WidgetMarketingVersion)&quot; CURRENT_PROJECT_VERSION=&quot;$(_WidgetBuildVersion)&quot; bash build-release.sh"
		      WorkingDirectory="$(_XcodeProjectDir)" />

		<Error Text="Expected staged widget at $(_WidgetDestAppex). See Platforms/iOS/Widgets/README.md."
		       Condition="!Exists('$(_WidgetDestAppex)')" />
		<Message Text="Widget extension staged at $(_WidgetDestAppex)" Importance="high" />
	</Target>

	<!-- Debug/maccatalyst: nach ~/Applications kopieren (Dev-Signatur startet unter macOS 26+ nicht aus /Applications) -->
	<Target Name="InstallToApplications"
			AfterTargets="_CodesignAppBundle"
			Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<Exec Command="mkdir -p &quot;$HOME/Applications&quot; &amp;&amp; rm -rf &quot;$HOME/Applications/$(ApplicationTitle).app&quot; &amp;&amp; ditto &quot;$(AppBundleDir)&quot; &quot;$HOME/Applications/$(ApplicationTitle).app&quot;" />
	</Target>

	<!-- actool-Icons vor Codesign ins .app (Release legt sie sonst nur unter obj/ ab) -->
	<Target Name="CopyMacCatalystActoolAssets"
			BeforeTargets="_CodesignAppBundle"
			DependsOnTargets="_CoreCompileImageAssets"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<PropertyGroup>
			<_FinanzAppBundle Condition="'$(AppBundleDir)' != ''">$(AppBundleDir)</_FinanzAppBundle>
			<_FinanzAppBundle Condition="'$(_FinanzAppBundle)' == ''">$(OutputPath)$(RuntimeIdentifier)/$(ApplicationTitle).app</_FinanzAppBundle>
			<_ActoolBundleDir Condition="Exists('$(IntermediateOutputPath)$(RuntimeIdentifier)/actool/bundle')">$(IntermediateOutputPath)$(RuntimeIdentifier)/actool/bundle</_ActoolBundleDir>
			<_ActoolBundleDir Condition="'$(_ActoolBundleDir)' == '' And Exists('$(IntermediateOutputPath)actool/bundle')">$(IntermediateOutputPath)actool/bundle</_ActoolBundleDir>
		</PropertyGroup>
		<ItemGroup Condition="'$(_ActoolBundleDir)' != '' And Exists('$(_FinanzAppBundle)')">
			<_ActoolAsset Include="$(_ActoolBundleDir)/*" />
		</ItemGroup>
		<Copy Condition="'@(_ActoolAsset)' != ''"
			  SourceFiles="@(_ActoolAsset)"
			  DestinationFolder="$(_FinanzAppBundle)/Contents/Resources"
			  SkipUnchangedFiles="true" />
	</Target>

	<!-- Set MAUI version properties from Nerdbank.GitVersioning at build time -->
	<Target Name="SetMauiVersionFromNBGV"
			BeforeTargets="Build;_GenerateBundleInfoPlist;_DetectAppManifest;_CompileAppManifest;MauiGeneratePackageAppxManifest"
			DependsOnTargets="GetBuildVersion">
		<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<ApplicationDisplayVersion>$(BuildVersion)</ApplicationDisplayVersion>
			<ApplicationVersion></ApplicationVersion>
		</PropertyGroup>
		<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
			<!-- User-facing release line — git height goes to CFBundleVersion via BuildVersionSimple -->
			<ApplicationDisplayVersion>$(MajorMinorVersion)</ApplicationDisplayVersion>
			<ApplicationVersion>$(BuildVersionSimple)</ApplicationVersion>
		</PropertyGroup>
	</Target>

</Project>
