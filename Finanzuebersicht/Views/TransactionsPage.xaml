<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Finanzuebersicht.Views"
             xmlns:vm="clr-namespace:Finanzuebersicht.ViewModels"
             xmlns:models="clr-namespace:Finanzuebersicht.Models"
             xmlns:conv="clr-namespace:Finanzuebersicht.Converters"
             xmlns:loc="clr-namespace:Finanzuebersicht.Extensions"
             xmlns:controls="clr-namespace:Finanzuebersicht.Controls"
             x:Class="Finanzuebersicht.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="{loc:Translate Nav_Transaktionen}">

    <views:BaseContentPage.Resources>
        <conv:TransactionTypToColorConverter x:Key="TypToColor" />
        <conv:BetragDisplayConverter x:Key="BetragDisplay" />
        <conv:KategorieIdToIconConverter x:Key="KategorieIdToIcon" />
        <conv:KategorieIdToColorConverter x:Key="KategorieIdToColor" />
        <conv:KategorieIdToNameConverter x:Key="KategorieIdToName" />
        <conv:AccountIdToNameConverter x:Key="AccountIdToName" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <conv:TransactionRowAccessibilityConverter x:Key="TransactionAccessibility" />
        <conv:CategoryRowAccessibilityConverter x:Key="CategoryAccessibility" />
        <conv:AccountRowAccessibilityConverter x:Key="AccountAccessibility" />
        <conv:RecurringRowAccessibilityConverter x:Key="RecurringAccessibility" />
        <conv:SparZielRowAccessibilityConverter x:Key="SparZielAccessibility" />

        <!-- Shared day/group card template (tap → GoToDetail, swipe → duplicate/delete).
             Used by both month and search CollectionViews (IsGrouped="False"),
             one card per TransactionGroup with rows rendered via BindableLayout. -->
        <DataTemplate x:Key="TransactionGroupCardTemplate" x:DataType="models:TransactionGroup">
            <VerticalStackLayout Padding="16,0,16,12" Spacing="8">
                <Label Text="{Binding DatumFormatiert}"
                       FontSize="12" FontAttributes="Bold"
                       TextTransform="Uppercase"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}"
                       Margin="6,8,6,0" />
                <Border StrokeShape="RoundRectangle 18" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="4,0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="{loc:Translate Btn_Duplizieren}"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type views:BaseContentPage}}, Path=BindingContext.DuplicateTransaktionCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="{loc:Translate Btn_Loeschen}"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource Ausgabe}, Dark={StaticResource AusgabeDark}}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type views:BaseContentPage}}, Path=BindingContext.DeleteTransaktionCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid ColumnDefinitions="44,*,Auto" Padding="14,10" ColumnSpacing="12">
                                        <SemanticProperties.Description>
                                            <MultiBinding Converter="{StaticResource TransactionAccessibility}">
                                                <Binding Path="." />
                                                <Binding Source="{RelativeSource AncestorType={x:Type views:BaseContentPage}}" Path="BindingContext.CategoryNameMap" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type views:BaseContentPage}}" Path="BindingContext.AccountMap" />
                                            </MultiBinding>
                                        </SemanticProperties.Description>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type views:BaseContentPage}}, Path=BindingContext.GoToDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                                StrokeShape="RoundRectangle 11" Stroke="Transparent">
                                            <Border.BackgroundColor>
                                                <MultiBinding Converter="{StaticResource KategorieIdToColor}">
                                                    <Binding Path="KategorieId" />
                                                    <Binding Source="{RelativeSource AncestorType={x:Type views:BaseContentPage}}" Path="BindingContext.ColorMap" />
                                                </MultiBinding>
                                            </Border.BackgroundColor>
                                            <Label FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding Converter="{StaticResource KategorieIdToIcon}">
                                                        <Binding Path="KategorieId" />
                                                        <Binding Source="{RelativeSource AncestorType={x:Type views:BaseContentPage}}"
                                                                 Path="BindingContext.IconMap" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Titel}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}"
                                                   LineBreakMode="TailTruncation">
                                                <Label.Text>
                                                    <MultiBinding Converter="{StaticResource KategorieIdToName}">
                                                        <Binding Path="KategorieId" />
                                                        <Binding Source="{RelativeSource AncestorType={x:Type views:BaseContentPage}}" Path="BindingContext.CategoryNameMap" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding ., Converter={StaticResource BetragDisplay}}"
                                               TextColor="{Binding Typ, Converter={StaticResource TypToColor}}"
                                               FontSize="15" FontAttributes="Bold"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
    </views:BaseContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *">

        <!-- Row 0: Suchleiste + Filter-Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="12,8,12,4" ColumnSpacing="8">
            <SearchBar Grid.Column="0"
                       Text="{Binding SearchText}"
                       Placeholder="{loc:Translate Hint_SucheTransaktionen}"
                       CancelButtonColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Button Grid.Column="1"
                    Text="{loc:Translate Btn_Filter}"
                    FontSize="14"
                    Command="{Binding ToggleFilterPanelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    BorderWidth="0"
                    CornerRadius="10"
                    Padding="12,8"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate A11y_FilterUmschalten}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsFilterActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Row 1: Monats-Chips (Vormonat / Aktuell / Nächster / Gesamt) — immer sichtbar,
             damit Gesamt auch im Suchmodus erreichbar bleibt. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="16,8,16,8">
            <HorizontalStackLayout Spacing="8">
                <!-- Vormonat -->
                <Border StrokeShape="RoundRectangle 99" Stroke="Transparent" Padding="14,7"
                        MinimumHeightRequest="44" MinimumWidthRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                    <SemanticProperties.Description>
                        <MultiBinding StringFormat="{}{0}, {1}">
                            <Binding Path="VormonatChipLabel" />
                            <loc:Translate Key="A11y_VorherigerMonat" />
                        </MultiBinding>
                    </SemanticProperties.Description>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding VormonatChipLabel}" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" />
                </Border>
                <!-- Aktuell -->
                <Border StrokeShape="RoundRectangle 99" Stroke="Transparent" Padding="14,7"
                        MinimumHeightRequest="44" MinimumWidthRequest="44">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonthChipActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonthChipActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <SemanticProperties.Description>
                        <MultiBinding StringFormat="{}{0}, {1}">
                            <Binding Path="MonatAnzeige" />
                            <loc:Translate Key="A11y_AktuellerMonat" />
                        </MultiBinding>
                    </SemanticProperties.Description>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCurrentMonthChipCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding MonatAnzeige}" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Border>
                <!-- Nächster -->
                <Border StrokeShape="RoundRectangle 99" Stroke="Transparent" Padding="14,7"
                        MinimumHeightRequest="44" MinimumWidthRequest="44"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                    <SemanticProperties.Description>
                        <MultiBinding StringFormat="{}{0}, {1}">
                            <Binding Path="NaechsterChipLabel" />
                            <loc:Translate Key="A11y_NaechsterMonat" />
                        </MultiBinding>
                    </SemanticProperties.Description>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding NaechsterChipLabel}" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" />
                </Border>
                <!-- Gesamt -->
                <Border StrokeShape="RoundRectangle 99" Stroke="Transparent" Padding="14,7"
                        MinimumHeightRequest="44" MinimumWidthRequest="44">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsGesamtChipActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsGesamtChipActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <SemanticProperties.Description>
                        <MultiBinding StringFormat="{}{0}, {1}">
                            <Binding Path="GesamtChipLabel" />
                            <loc:Translate Key="A11y_GesamtAnzeigen" />
                        </MultiBinding>
                    </SemanticProperties.Description>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EnterGesamtModeCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding GesamtChipLabel}" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Row 2: Filter-Panel (collapsible) -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 0"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="12,8"
                IsVisible="{Binding IsFilterPanelOpen}">
            <VerticalStackLayout Spacing="10">

                <!-- Kategorie-Filter -->
                <Grid ColumnDefinitions="80, *" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:Translate Lbl_AlleKategorien}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <controls:SelectionField Grid.Column="1"
                                             ItemsSource="{Binding AvailableKategorien}"
                                             SelectedItem="{Binding SelectedKategorieFilterItem, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayName"
                                             Placeholder="{loc:Translate Lbl_AlleKategorien}" />
                </Grid>

                <!-- Konto-Filter -->
                <Grid ColumnDefinitions="80, *" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:Translate Lbl_Konto}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <controls:SelectionField Grid.Column="1"
                                             ItemsSource="{Binding AvailableKonten}"
                                             SelectedItem="{Binding SelectedKontoFilterItem, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayName"
                                             Placeholder="{loc:Translate Lbl_AlleKonten}" />
                </Grid>

                <!-- Typ-Filter -->
                <Grid ColumnDefinitions="80, *" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:Translate Lbl_AlleTypen}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <controls:SelectionField Grid.Column="1"
                                             ItemsSource="{Binding TypFilterItems}"
                                             SelectedItem="{Binding SelectedTypFilterItem, Mode=TwoWay}"
                                             DisplayMemberPath=""
                                             Placeholder="{loc:Translate Lbl_AlleTypen}" />
                </Grid>

                <!-- Datum-Filter aktivieren -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:Translate Lbl_VonDatum}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsDateFilterEnabled}" />
                </Grid>

                <!-- Datum Von/Bis (nur wenn aktiviert) -->
                <Grid ColumnDefinitions="80, *, 40, *" ColumnSpacing="8"
                      IsVisible="{Binding IsDateFilterEnabled}">
                    <Label Grid.Column="0" Text="{loc:Translate Lbl_VonDatum}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <DatePicker Grid.Column="1"
                                Date="{Binding VonDatumPicker}"
                                Format="dd.MM.yyyy" FontSize="14" />
                    <Label Grid.Column="2" Text="{loc:Translate Lbl_BisDatum}"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" VerticalTextAlignment="Center" />
                    <DatePicker Grid.Column="3"
                                Date="{Binding BisDatumPicker}"
                                Format="dd.MM.yyyy" FontSize="14" />
                </Grid>

                <!-- Filter zurücksetzen -->
                <Button Text="{loc:Translate Btn_FilterZuruecksetzen}"
                        FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Ausgabe}, Dark={StaticResource AusgabeDark}}"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsFilterActive}"
                        Command="{Binding ClearSearchCommand}" />
            </VerticalStackLayout>
        </Border>

        <!-- Row 3: Häufig verwendet — kompakte Chips (Name = Aktion, × = löschen) -->
        <VerticalStackLayout Grid.Row="3"
                             Spacing="4"
                             Padding="12,2,12,2"
                             IsVisible="{Binding ShowTransactionTemplates}">
            <Label Text="{loc:Translate Lbl_HaeufigVerwendet}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}" />
            <CollectionView ItemsSource="{Binding TransactionTemplates}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="40">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionTemplate">
                        <Grid Margin="0,0,8,0"
                              WidthRequest="128"
                              MinimumWidthRequest="128"
                              MaximumWidthRequest="180">
                            <Button Text="{Binding Name}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    Padding="14,0,36,0"
                                    CornerRadius="18"
                                    HeightRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=CreateFromTemplateCommand}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding Name}" />
                            <Button Text="×"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    Opacity="0.9"
                                    Padding="0"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="0,0,2,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=DeleteTemplateCommand}"
                                    CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{loc:Translate Btn_Loeschen}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Row 4: Unkategorisiert-Hinweis (opake Leiste) -->
        <Border Grid.Row="4"
                StrokeShape="RoundRectangle 0"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                Padding="12,8"
                IsVisible="{Binding HasUncategorizedTransactions}">
            <Button Text="{Binding UncategorizedBadgeText}"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="10,6"
                    CornerRadius="8"
                    HorizontalOptions="Start"
                    Command="{Binding FilterUncategorizedCommand}" />
        </Border>

        <!-- Row 5: Content -->
        <Grid Grid.Row="5">

            <!-- Monatsansicht (normal) -->
            <RefreshView Command="{Binding LoadTransaktionenCommand}"
                         IsRefreshing="{Binding IsLoading}"
                         IsVisible="{Binding IsMonthMode}">
                <CollectionView ItemsSource="{Binding TransaktionsGruppen}"
                                IsGrouped="False"
                                SelectionMode="None"
                                ItemTemplate="{StaticResource TransactionGroupCardTemplate}">
                    <CollectionView.EmptyView>
                        <controls:EmptyStateView IconImage="transactions.png"
                                                 IconAccessibilityDescription="{loc:Translate Nav_Transaktionen}"
                                                 Message="{loc:Translate Empty_KeineTransaktionen}"
                                                 Hint="{loc:Translate Empty_HintTransaktionen}"
                                                 ActionText="{loc:Translate Btn_ErsteTransaktion}"
                                                 ActionCommand="{Binding GoToDetailCommand}" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <!-- Suchergebnisse / Gesamt.
                 Grid (Auto,*) statt VerticalStackLayout: CollectionView needs a bounded
                 height to scroll; in a stack it expands to content and rubber-bands. -->
            <Grid IsVisible="{Binding IsSearchActive}" RowDefinitions="Auto, *">

                <!-- Ergebnis-Anzahl -->
                <Label Grid.Row="0"
                       Padding="16,8,16,4"
                       FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}"
                       IsVisible="{Binding HasSearchResults}"
                       Text="{Binding SearchCountText}" />

                <!-- Keine Ergebnisse -->
                <Label Grid.Row="1"
                       Text="{loc:Translate Empty_KeineSuchergebnisse}"
                       FontSize="16" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray600}}"
                       VerticalOptions="Start"
                       Margin="0,40,0,0"
                       IsVisible="{Binding HasSearchResults, Converter={StaticResource InvertBool}}" />

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding SearchErgebnisGruppen}"
                                IsGrouped="False"
                                SelectionMode="None"
                                IsVisible="{Binding HasSearchResults}"
                                ItemTemplate="{StaticResource TransactionGroupCardTemplate}" />
            </Grid>

        </Grid>

        <!-- FABs: Import, Umbuchen, Neue Transaktion.
             CascadeInputTransparent=False: parent stays pass-through for the list,
             but children must receive taps (default cascade would disable all FABs;
             taps then hit list rows → TransactionDetail). -->
        <VerticalStackLayout Grid.Row="5"
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Padding="20,0,20,20"
                             Spacing="12"
                             InputTransparent="True"
                             CascadeInputTransparent="False">
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="11"
                    SemanticProperties.Description="{loc:Translate A11y_CsvImport}"
                    Shadow="{Shadow Brush='#40000000', Offset='0,3', Radius=6}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ImportCsvCommand}" />
                </Border.GestureRecognizers>
                <Image Source="fab_import.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True" />
            </Border>
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="11"
                    SemanticProperties.Description="{loc:Translate A11y_UmbuchungHinzufuegen}"
                    Shadow="{Shadow Brush='#40000000', Offset='0,3', Radius=6}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToTransferCommand}" />
                </Border.GestureRecognizers>
                <Image Source="fab_transfer.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True" />
            </Border>
            <Button Text="{loc:Translate Btn_Hinzufuegen}"
                    FontSize="28"
                    TextColor="White"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    CornerRadius="28"
                    WidthRequest="56"
                    HeightRequest="56"
                    SemanticProperties.Description="{loc:Translate A11y_TransaktionHinzufuegen}"
                    Shadow="{Shadow Brush='#40000000', Offset='0,4', Radius=8}"
                    Command="{Binding GoToDetailCommand}" />
        </VerticalStackLayout>

    </Grid>
</views:BaseContentPage>
