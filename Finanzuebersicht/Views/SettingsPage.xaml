<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finanzuebersicht.ViewModels"
             xmlns:loc="clr-namespace:Finanzuebersicht.Extensions"
             x:Class="Finanzuebersicht.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Nav_Einstellungen}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="24" Padding="0,0,0,24">

            <!-- Darstellung -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Darstellung}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="{loc:Translate Btn_System}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetThemeCommand}"
                                CommandParameter="0"
                                BackgroundColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=0}"
                                TextColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=0}" />
                        <Button Text="{loc:Translate Btn_Hell}"
                                Grid.Column="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetThemeCommand}"
                                CommandParameter="1"
                                BackgroundColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=1}"
                                TextColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=1}" />
                        <Button Text="{loc:Translate Btn_Dunkel}"
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetThemeCommand}"
                                CommandParameter="2"
                                BackgroundColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=2}"
                                TextColor="{Binding Appearance.SelectedThemeIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=2}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sprache -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Sprache}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="{loc:Translate Stn_SpracheSystem}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetLanguageCommand}"
                                CommandParameter="0"
                                BackgroundColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=0}"
                                TextColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=0}" />
                        <Button Text="{loc:Translate Stn_SpracheDeutsch}"
                                Grid.Column="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetLanguageCommand}"
                                CommandParameter="1"
                                BackgroundColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=1}"
                                TextColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=1}" />
                        <Button Text="{loc:Translate Stn_SpracheEnglisch}"
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetLanguageCommand}"
                                CommandParameter="2"
                                BackgroundColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=2}"
                                TextColor="{Binding Appearance.SelectedLanguageIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=2}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Anzeige-Währung -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Anzeigewaehrung}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Text="{loc:Translate Stn_CurrencyEur}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetCurrencyCommand}"
                                CommandParameter="0"
                                BackgroundColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=0}"
                                TextColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=0}" />
                        <Button Text="{loc:Translate Stn_CurrencyChf}"
                                Grid.Column="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetCurrencyCommand}"
                                CommandParameter="1"
                                BackgroundColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=1}"
                                TextColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=1}" />
                        <Button Text="{loc:Translate Stn_CurrencyUsd}"
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetCurrencyCommand}"
                                CommandParameter="2"
                                BackgroundColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=2}"
                                TextColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=2}" />
                        <Button Text="{loc:Translate Stn_CurrencyGbp}"
                                Grid.Column="3"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Appearance.SetCurrencyCommand}"
                                CommandParameter="3"
                                BackgroundColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonConverter}, ConverterParameter=3}"
                                TextColor="{Binding Appearance.SelectedCurrencyIndex, Converter={StaticResource ThemeButtonTextConverter}, ConverterParameter=3}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Speicherort -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Speicherort}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Label Text="{loc:Translate Lbl_DatenWerdenGespeichert}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <Border StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            Padding="12,8"
                            StrokeThickness="0">
                        <Label Text="{Binding Storage.DataPath}"
                               FontSize="13"
                               FontFamily="monospace"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </Border>

                    <Label Text="{loc:Translate Hint_SpeicherortNeustart}"
                           IsVisible="{Binding Storage.RequiresRestart}"
                           FontSize="12"
                           TextColor="{StaticResource TextTertiary}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:Translate Btn_OrdnerWaehlen}"
                                Command="{Binding Storage.ChooseDataPathCommand}"
                                FontSize="14"
                                Padding="12,8" />
                        <Button Text="{loc:Translate Btn_Zuruecksetzen}"
                                Command="{Binding Storage.ResetDataPathCommand}"
                                FontSize="14"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </HorizontalStackLayout>

                    <Label Text="{loc:Translate Hint_iCloudTipp}"
                           FontSize="12"
                           TextColor="{StaticResource TextTertiary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Backup & Restore -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Translate Msg_BackupRestoreTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label Text="{loc:Translate Msg_BackupRestoreDesc}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="{loc:Translate Btn_BackupCreate}"
                            Command="{Binding Backup.CreateBackupCommand}"
                            FontSize="14"
                            Padding="12,8" />
                        <Button Text="{loc:Translate Btn_BackupManage}"
                            Grid.Column="1"
                            Command="{Binding Backup.BrowseBackupsCommand}"
                            FontSize="14"
                            Padding="12,8" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="{loc:Translate Btn_BackupRestore}"
                            Command="{Binding Backup.RestoreBackupCommand}"
                            FontSize="14"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                        <Button Text="{loc:Translate Btn_ExportCSV}"
                            Grid.Column="1"
                            Command="{Binding Backup.ExportAsCSVCommand}"
                            FontSize="14"
                            Padding="12,8" />
                        </Grid>

                    <Label Text="{Binding Backup.LastBackupInfo}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Widget-Shortcuts (Pro / Quick Expense) -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding WidgetPresets.SectionTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding WidgetPresets.SectionHint}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}" />
                    <Label Text="{Binding WidgetPresets.ProHint}"
                           IsVisible="{Binding WidgetPresets.ShowProHint}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />

                    <!-- HasProAccess only (not CanEdit/IsBusy): disabling Entries mid-save drops focus
                         before TwoWay Text is committed on iOS. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding WidgetPresets.Slots}"
                                         Spacing="12"
                                         IsEnabled="{Binding WidgetPresets.HasProAccess}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickExpenseWidgetPresetSlotItem">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding SlotLabel, StringFormat='#{0}'}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry Text="{Binding Title, Mode=TwoWay}"
                                           Placeholder="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.WidgetPresets.TitlePlaceholder}"
                                           FontSize="16" />
                                    <Entry Text="{Binding AmountText, Mode=TwoWay}"
                                           Placeholder="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.WidgetPresets.AmountPlaceholder}"
                                           Keyboard="Numeric"
                                           FontSize="16" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="{loc:Translate Btn_Speichern}"
                            Clicked="OnWidgetPresetsSaveClicked"
                            IsEnabled="{Binding WidgetPresets.CanEdit}"
                            FontSize="14"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Lizenz / Free · Pro · Sync -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Lic_SectionTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding License.ChannelLabel}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="{Binding License.TierLabel}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding License.SyncLabel}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="{Binding License.LimitsHint}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}" />

                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding License.ShowStorePurchaseControls}">
                        <Label Text="{Binding License.ProPriceLabel}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        <Button Text="{loc:Translate Lic_BuyPro}"
                                Command="{Binding License.BuyProCommand}"
                                IsEnabled="{Binding License.CanBuyPro}"
                                FontSize="14"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="White" />
                        <Button Text="{loc:Translate Lic_RestorePurchases}"
                                Command="{Binding License.RestorePurchasesCommand}"
                                FontSize="14"
                                Padding="12,8" />
                        <Label Text="{loc:Translate Lic_SyncPurchaseLater}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding License.ShowStoreStubControls}">
                        <Label Text="{loc:Translate Lic_StubHint}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{loc:Translate Lic_StubPro}"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding License.StubProEnabled}" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{loc:Translate Lic_StubSync}"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding License.StubSyncEnabled}" />
                        </Grid>
                        <Button Text="{loc:Translate Lic_StubApply}"
                                Command="{Binding License.ApplyStubEntitlementsCommand}"
                                FontSize="14"
                                Padding="12,8" />
                        <Button Text="{loc:Translate Lic_UseStoreKit}"
                                Command="{Binding License.UseStoreKitInsteadOfStubCommand}"
                                FontSize="14"
                                Padding="12,8" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Hilfe / Einrichtung -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Hilfe}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{loc:Translate Hint_EinrichtungWiederholen}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <Button Text="{loc:Translate Btn_EinrichtungWiederholen}"
                            Command="{Binding ShowOnboardingAgainCommand}"
                            FontSize="14"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Über -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Lbl_Ueber}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                           <Label Text="{loc:Translate Title_AppName}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Grid.Column="1" Text="{Binding About.AppVersion}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding About.BuildInfo, StringFormat='Build: {0}'}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Separator}, Dark={StaticResource SeparatorDark}}" />

                    <Label Text="{loc:Translate Lbl_VerwendeteBibliotheken}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding About.Libraries}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryInfo">
                                <VerticalStackLayout Padding="0,4">
                                    <Label Text="{Binding Name}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                          <Label Text="{loc:Translate Lbl_FrameworkInfo}"
                              FontSize="12"
                              HorizontalTextAlignment="Center"
                              TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource Gray400}}"
                              Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>
        </ScrollView>
        <Label Grid.Row="1"
               Text="▼"
               FontSize="10"
               HorizontalTextAlignment="Center"
               Padding="0,2,0,6"
               InputTransparent="True"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray600}}" />
    </Grid>
</ContentPage>
